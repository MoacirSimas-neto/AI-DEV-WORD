{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Dev World",
  "version": "0.1.0",
  "identifier": "com.aidevworld.desktop",
  "build": {
    "beforeDevCommand": "npm run dev -w web",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build -w web",
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "AI Dev World",
        "width": 1366,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ws://127.0.0.1:* http://127.0.0.1:*;"
    }
  },
  "bundle": {
    "externalBin": [
      "binaries/node"
    ],
    "resources": [
      "../server/src/**/*",
      "../server/package.json",
      "../shared/**/*",
      "../node_modules/node-pty/**/*",
      "../node_modules/ws/**/*"
    ]
  }
}
