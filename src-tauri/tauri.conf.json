{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Dev World",
  "version": "1.0.0",
  "identifier": "com.aidevworld.desktop",
  "build": {
    "beforeDevCommand": "npm run dev -w web",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "node scripts/prepare-sidecar.mjs && npm run build -w web",
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "AI Dev World",
        "width": 1366,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ws://127.0.0.1:* http://127.0.0.1:*;"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/node"
    ],
    "resources": [
      "../server/src/**/*",
      "../server/package.json",
      "../shared/**/*",
      "../knowledge/agents/tech-lead.md",
      "../knowledge/agents/developer.md",
      "../knowledge/agents/qa-tester.md",
      "../knowledge/tech-lead/principios.md",
      "../knowledge/tech-lead/dossie.md",
      "../knowledge/tech-lead/referencias.md",
      "../knowledge/developer/principios.md",
      "../knowledge/developer/dossie.md",
      "../knowledge/developer/referencias.md",
      "../knowledge/qa-tester/principios.md",
      "../knowledge/qa-tester/dossie.md",
      "../knowledge/qa-tester/referencias.md",
      "../knowledge/skills/ponytail.md",
      "../knowledge/skills/caveman-lite.md",
      "../knowledge/skills/NOTICE.md",
      "../node_modules/node-pty/**/*",
      "../node_modules/ws/**/*"
    ]
  }
}
